{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "microphone=(self), camera=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://accounts.google.com https://apis.google.com https://sdk.twilio.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://maps.googleapis.com https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src 'self' https://* wss://* blob:; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com; media-src 'self' blob: data:; frame-ancestors 'self';"
          }
        ]
      },
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/dialer",
        "destination": "/dialer.html"
      },
      {
        "source": "/canvas",
        "destination": "/canvas.html"
      },
      {
        "source": "/agents",
        "destination": "/agents.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/mobile",
        "destination": "/mobile.html"
      },
      {
        "source": "/manifest.json",
        "destination": "/manifest.json"
      },
      {
        "source": "/sw.js",
        "destination": "/sw.js"
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/twiml",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/twiml/**",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/voice",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/voice/**",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/ivr",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/audio/**",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/transfer-fallback",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/recording-callback",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/status-callback",
        "run": {
          "serviceId": "rhive-voice-live-bridge",
          "region": "us-central1"
        }
      },
      {
        "source": "/verify",
        "destination": "/verify.html"
      },
      {
        "source": "**",
        "destination": "/dialer.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}